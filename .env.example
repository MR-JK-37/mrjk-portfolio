# Public canonical URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_RESUME_URL=
GITHUB_USERNAME=
ENABLE_CONTACT_FORM=false

# Admin authentication: generate with `node scripts/hash-password.mjs "your password"`
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash
SESSION_SECRET=replace-with-at-least-32-random-characters

# Contact delivery (Resend-compatible HTTP API)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Real Cloudinary credentials. Uploads fail loudly when any value is missing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
